# ==========================================================================
# DOCRACK — ENVIRONMENT VARIABLES
# ==========================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# ==========================================================================

# --- Google Sheets (Required) ---
# The spreadsheet ID from its URL: https://docs.google.com/spreadsheets/d/<ID>/edit
# The sheet must be shared (Editor) with your GCP service account's email.

GOOGLE_SHEET_ID=your-sheet-id-here

# --- Google credentials (LOCAL DEV ONLY) ---
# Path to the downloaded service-account JSON key (gitignored).
# NOT needed on Cloud Run — there the service account attached to the
# service provides keyless Application Default Credentials.

GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa-key.json

# --- Resend Email Notifications (Optional but recommended) ---
# Server-side only. On Cloud Run, inject RESEND_API_KEY from Secret Manager,
# not as a plain env var.

RESEND_API_KEY=re_your_resend_api_key
NOTIFY_EMAIL=you@yourdomain.com

# Only set after verifying docrack.ai at Resend (until then, emails are sent
# from onboarding@resend.dev and only deliver to your Resend account email):
# EMAIL_FROM=DocRack <notifications@docrack.ai>
