# ==========================================================================
# ORVYN — ENVIRONMENT VARIABLES
# ==========================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# ==========================================================================

# --- Supabase (Required) ---
# Find these in: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Supabase Service Role Key (Recommended for production) ---
# Used SERVER-SIDE ONLY in API route handlers (/api/demo-booking, /api/support-ticket)
# Enables: duplicate email checks, admin reads bypassing RLS
# Find in: Supabase Dashboard → Project Settings → API → service_role key
# WARNING: NEVER prefix with NEXT_PUBLIC_ — this must stay server-side only

SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Resend Email Notifications (Optional) ---
# Set these as Supabase Edge Function Secrets, NOT here.
# See: supabase/functions/notify-demo-booking/index.ts
#
# RESEND_API_KEY=re_your_resend_api_key
# NOTIFY_EMAIL=you@yourdomain.com
