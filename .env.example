# DocRack-Web - runtime integration configuration (Phase 6)
# Copy only into a missing local env file; preserve existing credentials/settings.
# Never use live env files/keys for automated tests. Pages/build need no secrets.
GOOGLE_SHEET_ID=
# LOCAL ONLY: optional test ADC key path. Cloud Run uses attached identity.
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/test-gcp-sa-key.json
RESEND_API_KEY=
NOTIFY_EMAIL=
# EMAIL_FROM=DocRack <notifications@docrack.ai>

# Exact comma-separated origins, no paths, wildcards or trailing slash.
# Required for browser submissions; blank fails closed with 403.
FORM_ALLOWED_ORIGINS=
# Example for the credential-free local QA image: http://127.0.0.1:3100
# Optional legitimate nonbrowser JSON clients; still rate limited. Default false.
ALLOW_MISSING_ORIGIN=false

# shared (default): ignore all forwarded/IP headers, use one conservative identity.
# verified-header: ONLY after verifying ingress overwrites x-docrack-client-ip
# with a single IP and direct service bypass is impossible. Hosting evidence pending.
FORM_INGRESS_MODE=shared
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
# Server-only secret, at least 32 random characters; bind through Secret Manager.
RATE_LIMIT_HMAC_SECRET=
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# Disabled by default. All switches + fixed domain required for activation.
# public-production is exclusively for an owner-approved public deployment.
SITE_ENVIRONMENT=private-preview
ANALYTICS_ENABLED=false
ANALYTICS_PROCESSING_APPROVED=false
PLAUSIBLE_DOMAIN=
