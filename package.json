{
  "name": "docrack-saas-mvp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "prepare": "husky install",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check-content": "vitest run tests/unit/content-assets.test.ts",
    "check-assets": "vitest run tests/unit/content-assets.test.ts",
    "assets:produce": "node scripts/produce-content-assets.mjs",
    "analyze": "node scripts/analyze.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.2.0",
    "@hookform/resolvers": "^3.6.0",
    "clsx": "^2.1.1",
    "google-auth-library": "11.0.2",
    "lucide-react": "1.45.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.51.5",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "husky": "^8.0.0",
    "jsdom": "^27.0.0",
    "lint-staged": "17.5.1",
    "postcss": "^8.4.38",
    "prettier": "^3.0.0",
    "sharp": "0.35.4",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html}": [
      "prettier --write"
    ]
  }
}
