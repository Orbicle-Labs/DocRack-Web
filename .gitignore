# ==========================================================================
# ORVYN — .gitignore
# ==========================================================================

# Environment variables — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Next.js build output
.next/
out/

# Node modules
node_modules/

# Production build
build/
dist/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Supabase local dev (not the functions themselves)
supabase/.temp/
supabase/config.toml
