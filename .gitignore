# ==========================================================================
# DOCRACK — .gitignore
# ==========================================================================

# Environment variables — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.docker.local

# Next.js build output
.next/
out/

# Node modules
node_modules/

# Production build
build/
dist/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# GCP service-account keys — NEVER commit
secrets/
*service-account*.json

# Local validation tools and browser artifacts
.local-tools/
test-results/
playwright-report/
