# Values for the Docker containers.
# Copy this file to .env.docker.local and fill in your values.
#
# Sheets auth inside the container uses the service-account key file mounted at
# /app/secrets/gcp-sa-key.json (see docker-compose.yml) — put your downloaded
# key at ./secrets/gcp-sa-key.json in the repo root (gitignored).

# --- Google Sheets (required) ---
# The spreadsheet ID from its URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=your-sheet-id-here

# --- Resend email notifications (optional but recommended) ---
RESEND_API_KEY=re_your_resend_api_key
NOTIFY_EMAIL=you@yourdomain.com
# Only set after verifying docrack.ai at Resend:
# EMAIL_FROM=DocRack <notifications@docrack.ai>
